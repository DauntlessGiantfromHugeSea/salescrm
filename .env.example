# ============================================================================
# Konfiguration des Akquisesystems.
# Diese Datei nach .env kopieren und ausfüllen. .env gehört NICHT ins Git.
# ============================================================================

# ---------------------------------------------------------------------------
# Domain und Betrieb
# ---------------------------------------------------------------------------

# Die Domain, unter der das Dashboard läuft. Der A-Record muss auf diesen
# Server zeigen, bevor der erste Start erfolgt – sonst schlägt die
# Zertifikatsausstellung fehl.
DOMAIN=akquise.example.de

# Adresse für Let's-Encrypt-Benachrichtigungen (ablaufende Zertifikate).
ACME_EMAIL=it@example.de

# Muss der öffentlichen Adresse entsprechen. Wird für Weiterleitungen nach der
# Anmeldung und für Buchungslinks benutzt.
PUBLIC_BASE_URL=https://akquise.example.de

# Adresse, unter der der mitgelieferte Caddy lauscht.
#   akquise.example.de  – automatisches Let's-Encrypt-Zertifikat
#   :80                 – reines HTTP, für Tests auf einer IP-Adresse
#   leer                – kein eigener Reverse Proxy; auf dem Server läuft schon
#                         einer, der auf WEB_PORT weiterleitet
SITE_ADDRESS=akquise.example.de

# Nur auf 127.0.0.1 gebundene Ports. Relevant, wenn ein vorhandener Proxy
# die Anwendung veröffentlicht.
WEB_PORT=8090
API_PORT=8091

# Demo-Modus: läuft ohne Microsoft-Mandanten und ohne KI-Schlüssel, mit
# Anmeldung ohne Microsoft. Zusammen mit NODE_ENV=production verweigert das
# System den Start. Siehe docs/TESTEN.md.
DEMO_MODE=false
DEMO_USER_EMAIL=demo@example.de

NODE_ENV=production
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------

POSTGRES_USER=salescrm
POSTGRES_PASSWORD=
POSTGRES_DB=salescrm

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD)
# Einrichtung Schritt für Schritt: docs/AZURE_SETUP.md
# ---------------------------------------------------------------------------

# Verzeichnis-ID (Mandant) aus der App-Registrierung.
MS_TENANT_ID=
# Anwendungs-ID (Client).
MS_CLIENT_ID=
# Geheimer Clientschlüssel. Läuft ab – Ablaufdatum notieren!
MS_CLIENT_SECRET=
# Muss zeichengenau mit der in Entra ID hinterlegten Umleitungs-URI übereinstimmen.
MS_REDIRECT_URI=https://akquise.example.de/api/auth/callback

# Firmenweiter Postfachzugriff.
# false = nur die Postfächer angemeldeter Benutzer werden gelesen.
# true  = auch gemeinsame Postfächer (info@, angebote@) und Postfächer von
#         Kollegen, die sich nicht selbst anmelden.
# Erfordert Admin-Zustimmung UND eine ApplicationAccessPolicy im Exchange,
# die den Zugriff auf die freigegebene Gruppe begrenzt. Ohne diese Richtlinie
# könnte die Anwendung jedes Postfach der Organisation lesen.
MS_APP_ONLY_ENABLED=false
# Name der Sicherheitsgruppe der Zugriffsrichtlinie (nur zur Anzeige im Dashboard).
MS_MAILBOX_GROUP=

# ---------------------------------------------------------------------------
# Sicherheit
# ---------------------------------------------------------------------------

# 32 Byte als Hex. Erzeugen mit: openssl rand -hex 32
# ACHTUNG: Wird dieser Schlüssel geändert, müssen sich alle Benutzer neu
# anmelden – die gespeicherten Microsoft-Tokens sind damit verschlüsselt.
ENCRYPTION_KEY=

# Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=

# Kommagetrennte Liste der Adressen, die sich anmelden dürfen.
# Leer lassen = jeder im Microsoft-Mandanten darf sich anmelden.
ALLOWED_LOGIN_EMAILS=

# Diese Adresse wird beim ersten Anmelden automatisch Administrator.
BOOTSTRAP_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# KI
# ---------------------------------------------------------------------------

# Optional. Ohne Schlüssel läuft alles weiter, was nichts mit Textproduktion
# zu tun hat: Mailimport, Projektakte, Kontakte, Teams-Termine, Excel-Export.
# Es entfallen Mailentwürfe, Besprechungsnotizen und Firmenprofile.
# Jederzeit nachtragbar, danach: docker compose up -d api worker
ANTHROPIC_API_KEY=

# Statisches Modell-Routing: großes Modell für Texte, kleines für Massenaufgaben.
AI_MODEL_DRAFTING=claude-sonnet-5
AI_MODEL_CLASSIFY=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Regelwerk – wann gilt ein Vorgang als offen
# ---------------------------------------------------------------------------

# Tage ohne Antwort, bis ein Follow-up fällig wird.
RULE_FOLLOW_UP_DAYS=14
# Tage ohne jeden Kontakt, ab denen ein Kontakt als reaktivierbar gilt.
RULE_REACTIVATION_DAYS=180
# Ab wie vielen Mails ein Mailpartner beim Import als echter Kontakt zählt.
RULE_MIN_EMAILS_FOR_CONTACT=3

# ---------------------------------------------------------------------------
# Import
# ---------------------------------------------------------------------------

# Wie weit der Erstimport zurückgeht. 24 Monate entspricht Stufe A der Spezifikation.
IMPORT_MONTHS_BACK=24

# Mailordner, die synchronisiert werden. Weitere Ordner können je Postfach
# im Dashboard gesetzt werden.
IMPORT_MAIL_FOLDERS=inbox,sentitems

# Eigene Maildomains. Absender daraus werden nicht als Leads angelegt –
# ohne diese Angabe landen alle Kollegen als vermeintliche Kunden im System.
INTERNAL_EMAIL_DOMAINS=example.de,example.com

# ---------------------------------------------------------------------------
# Zeitsteuerung (alle Angaben in UTC!)
# Deutschland liegt im Winter 1, im Sommer 2 Stunden vor UTC.
# ---------------------------------------------------------------------------

# Nächtlicher Abgleich aller Postfächer: 03:00 UTC = 04:00/05:00 Ortszeit.
CRON_NIGHTLY_SYNC=0 3 * * *
# Tägliche Priorisierung, werktags: 04:30 UTC = 05:30/06:30 Ortszeit.
CRON_DAILY_SCAN=30 4 * * 1-5
# Stündlicher Nachlauf für Besprechungstranskripte.
CRON_TRANSCRIPT_FETCH=0 * * * *

# ---------------------------------------------------------------------------
# Entwürfe
# ---------------------------------------------------------------------------

# Sollen im Tageslauf Entwürfe für fällige Follow-ups vorproduziert werden?
AUTO_GENERATE_FOLLOWUP_DRAFTS=true
# Obergrenze pro Lauf und Benutzer. Kostenbremse.
MAX_AUTO_DRAFTS_PER_RUN=15
